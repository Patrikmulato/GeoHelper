{
  "name": "geoguessr-helper-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "tsx --test src/**/*.test.ts",
    "sync:carmeta": "tsx scripts/sync-carmeta.ts",
    "sync:data": "tsx scripts/sync-geocarhelpdesk.ts && pnpm merge:crawlers",
    "sync:data:pull": "git -C ../../GeoCarHelpDesk pull --ff-only && pnpm sync:data",
    "crawl:guides": "tsx crawlers/plonk/crawl-guides.ts",
    "consolidate:guides": "tsx crawlers/plonk/consolidate.ts",
    "extract:guides": "tsx crawlers/plonk/extract-guide-data.ts",
    "merge:crawlers": "tsx crawlers/plonk/append-crawler-data-to-backend-data.ts",
    "extract:guides:ai": "tsx crawlers/agent/extract-guide-data-ai.ts",
    "merge:ai": "tsx crawlers/agent/merge-ai-extraction.ts",
    "pipeline:ai": "pnpm extract:guides:ai && pnpm merge:ai"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "^5.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/node": "25.9.5",
    "@types/supertest": "7.2.0",
    "@anthropic-ai/sdk": "^0.110.0",
    "puppeteer": "25.3.0",
    "supertest": "7.2.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  }
}
